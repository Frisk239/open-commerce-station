# Public variable contract. The Docker database value is local-only; put every real secret in .env.local.

# Foundation runtime
DATABASE_URL=postgresql://open_commerce_station:local-development-only@localhost:5432/open_commerce_station
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace_with_a_long_random_value
AUTH_TRUST_HOST=true
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_a_stable_32_byte_base64_value
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=replace_with_a_password_hash
UPLOAD_DIR=/var/lib/open-commerce-station/uploads
PUBLIC_BASE_URL=http://localhost:3000
# Local end-to-end tests only. Never set this in production.
# OCS_PAYMENT_ADAPTER=deterministic

# store-global / PayPal Sandbox
PAYPAL_ENVIRONMENT=your_paypal_sandbox_environment
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_SANDBOX_BUSINESS_EMAIL=your_paypal_sandbox_business_email
PAYPAL_SANDBOX_BUSINESS_PASSWORD=your_paypal_sandbox_business_password
PAYPAL_SANDBOX_PERSONAL_EMAIL=your_paypal_sandbox_personal_email
PAYPAL_SANDBOX_PERSONAL_PASSWORD=your_paypal_sandbox_personal_password

# store-global / Stripe Test Mode
STRIPE_MODE=your_stripe_test_mode
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# store-cn / Alipay Sandbox
ALIPAY_ENVIRONMENT=your_alipay_sandbox_environment
ALIPAY_APP_ID=your_alipay_sandbox_app_id
ALIPAY_APP_PRIVATE_KEY=your_base64_alipay_app_private_key
ALIPAY_APP_PUBLIC_KEY=your_base64_alipay_app_public_key
ALIPAY_PUBLIC_KEY=your_base64_alipay_public_key
ALIPAY_GATEWAY_URL=your_alipay_sandbox_gateway_url
ALIPAY_SANDBOX_MERCHANT_ACCOUNT=your_alipay_sandbox_merchant_account
ALIPAY_SANDBOX_MERCHANT_LOGIN_PASSWORD=your_alipay_sandbox_merchant_login_password
ALIPAY_SANDBOX_MERCHANT_PID=your_alipay_sandbox_merchant_pid
ALIPAY_SANDBOX_BUYER_ACCOUNT=your_alipay_sandbox_buyer_account
ALIPAY_SANDBOX_BUYER_LOGIN_PASSWORD=your_alipay_sandbox_buyer_login_password
ALIPAY_SANDBOX_BUYER_PAYMENT_PASSWORD=your_alipay_sandbox_buyer_payment_password
ALIPAY_SANDBOX_BUYER_UID=your_alipay_sandbox_buyer_uid
