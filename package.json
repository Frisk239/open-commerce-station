{
  "name": "open-commerce-station",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev:cn": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/store-cn dev",
    "dev:global": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/store-global dev",
    "start:cn": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/store-cn start",
    "start:global": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/store-global start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data test:db",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d postgres redis",
    "db:up:postgres": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data db:generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data db:migrate",
    "db:migrate:dev": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data db:migrate:dev",
    "db:seed": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data db:seed",
    "owner:hash": "node --env-file-if-exists=.env.local scripts/run-workspace.mjs --filter @ocs/data owner:hash"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
