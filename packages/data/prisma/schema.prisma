generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Station {
  flavor         String   @id @db.VarChar(16)
  name           String   @db.VarChar(120)
  logoUrl        String?  @db.VarChar(512)
  faviconUrl     String?  @db.VarChar(512)
  contactEmail   String?  @db.VarChar(320)
  footerLine     String?  @db.VarChar(240)
  icp            String?  @db.VarChar(120)
  policeRecord   String?  @db.VarChar(120)
  policeBadgeUrl String?  @db.VarChar(512)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Owner {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shopper {
  id           String   @id @default(cuid())
  flavor       String   @db.VarChar(16)
  email        String   @db.VarChar(320)
  passwordHash String   @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses       ShopperAddress[]
  paymentAttempts PaymentAttempt[]
  orders          Order[]
  passwordResets  ShopperPasswordReset[]

  @@unique([flavor, email])
  @@index([flavor, createdAt])
}

model ShopperAddress {
  id            String   @id @default(cuid())
  shopperId     String
  recipientName String   @db.VarChar(120)
  phone         String   @db.VarChar(40)
  countryCode   String   @db.Char(2)
  region        String   @db.VarChar(120)
  city          String   @db.VarChar(120)
  district      String?  @db.VarChar(120)
  postalCode    String?  @db.VarChar(32)
  line1         String   @db.VarChar(240)
  line2         String?  @db.VarChar(240)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([shopperId, isDefault, updatedAt])
}

model DiscountCode {
  id            String   @id @default(cuid())
  flavor        String   @db.VarChar(16)
  code          String   @db.VarChar(64)
  kind          String   @db.VarChar(16)
  percentageBps Int?
  amountMinor   Int?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([flavor, code])
  @@index([flavor, enabled, createdAt])
}

model ShippingRate {
  id             String   @id @default(cuid())
  flavor         String   @db.VarChar(16)
  nameZh         String?  @db.VarChar(160)
  nameEn         String?  @db.VarChar(160)
  enabled        Boolean  @default(true)
  countryCodes   String[] @default([])
  regions        String[] @default([])
  minWeightGrams Int      @default(0)
  maxWeightGrams Int?
  priceMinor     Int
  freeOverMinor  Int?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([flavor, enabled, position])
}

model Policy {
  flavor    String   @db.VarChar(16)
  slug      String   @db.VarChar(32)
  bodyZh    String?
  bodyEn    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([flavor, slug])
}

model CatalogGroup {
  id        String   @id @default(cuid())
  flavor    String   @db.VarChar(16)
  slug      String   @db.VarChar(180)
  nameZh    String?  @db.VarChar(160)
  nameEn    String?  @db.VarChar(160)
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   CatalogGroup?            @relation("CatalogGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CatalogGroup[]           @relation("CatalogGroupTree")
  products ProductGroupAssignment[]

  @@unique([flavor, slug])
  @@index([flavor, parentId, position])
}

model Product {
  id        String    @id @default(cuid())
  flavor    String    @db.VarChar(16)
  slug      String    @db.VarChar(180)
  nameZh    String?   @db.VarChar(160)
  nameEn    String?   @db.VarChar(160)
  storyZh   String?
  storyEn   String?
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images   ProductImage[]
  groups   ProductGroupAssignment[]
  options  ProductOption[]
  variants ProductVariant[]

  @@unique([flavor, slug])
  @@index([flavor, published, deletedAt, createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String @db.VarChar(512)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, position])
}

model ProductGroupAssignment {
  productId String
  groupId   String

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   CatalogGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model ProductOption {
  id        String  @id
  productId String
  key       String  @db.VarChar(80)
  nameZh    String? @db.VarChar(160)
  nameEn    String? @db.VarChar(160)
  position  Int     @default(0)

  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]
  selections VariantSelection[]

  @@unique([productId, key])
  @@index([productId, position])
}

model ProductOptionValue {
  id       String  @id
  optionId String
  key      String  @db.VarChar(80)
  nameZh   String? @db.VarChar(160)
  nameEn   String? @db.VarChar(160)
  position Int     @default(0)

  option     ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantSelection[]

  @@unique([optionId, key])
  @@index([optionId, position])
}

model ProductVariant {
  id                 String @id
  productId          String
  combinationKey     String @db.VarChar(512)
  sellPriceMinor     Int
  originalPriceMinor Int?
  stock              Int
  reservedStock      Int    @default(0)
  weightGrams        Int

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  selections   VariantSelection[]
  cartLines    CartLine[]
  paymentLines PaymentAttemptLine[]
  reservations StockReservation[]

  @@unique([productId, combinationKey])
  @@index([productId])
}

model VariantSelection {
  variantId String
  optionId  String
  valueId   String

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option  ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([valueId])
}

model Cart {
  id        String   @id @default(cuid())
  flavor    String   @db.VarChar(16)
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines           CartLine[]
  paymentAttempts PaymentAttempt[]

  @@index([flavor, updatedAt])
}

model PaymentMethodConfig {
  flavor    String   @db.VarChar(16)
  provider  String   @db.VarChar(24)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([flavor, provider])
}

model PaymentAttempt {
  id                    String    @id @default(cuid())
  publicId              String    @unique @db.VarChar(64)
  flavor                String    @db.VarChar(16)
  shopperId             String
  cartId                String?
  checkoutFingerprint   String    @db.Char(64)
  provider              String    @db.VarChar(24)
  providerOrderId       String?   @db.VarChar(191)
  status                String    @default("pending") @db.VarChar(24)
  currency              String    @db.Char(3)
  subtotalMinor         Int
  discountCode          String?   @db.VarChar(64)
  discountMinor         Int
  shippingRateReference String?   @db.VarChar(191)
  shippingNameZh        String?   @db.VarChar(160)
  shippingNameEn        String?   @db.VarChar(160)
  shippingMinor         Int
  totalMinor            Int
  totalWeightGrams      Int
  recipientName         String    @db.VarChar(120)
  phone                 String    @db.VarChar(40)
  countryCode           String    @db.Char(2)
  region                String    @db.VarChar(120)
  city                  String    @db.VarChar(120)
  district              String?   @db.VarChar(120)
  postalCode            String?   @db.VarChar(32)
  line1                 String    @db.VarChar(240)
  line2                 String?   @db.VarChar(240)
  providerTradeNo       String?   @db.VarChar(128)
  failureCode           String?   @db.VarChar(80)
  expiresAt             DateTime
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shopper      Shopper                @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  cart         Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  lines        PaymentAttemptLine[]
  reservations StockReservation[]
  events       PaymentProviderEvent[]
  order        Order?

  @@unique([provider, providerTradeNo])
  @@index([shopperId, status, createdAt])
  @@index([status, expiresAt])
}

model PaymentAttemptLine {
  id                String  @id @default(cuid())
  paymentAttemptId  String
  variantId         String?
  variantReference  String  @db.VarChar(191)
  productReference  String  @db.VarChar(191)
  productSlug       String  @db.VarChar(180)
  productNameZh     String? @db.VarChar(160)
  productNameEn     String? @db.VarChar(160)
  variantLabel      String  @db.VarChar(512)
  imageUrl          String? @db.VarChar(512)
  unitPriceMinor    Int
  quantity          Int
  lineSubtotalMinor Int
  unitWeightGrams   Int

  paymentAttempt PaymentAttempt  @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([paymentAttemptId, variantReference])
  @@index([variantId])
}

model StockReservation {
  id               String    @id @default(cuid())
  paymentAttemptId String
  variantId        String?
  variantReference String    @db.VarChar(191)
  quantity         Int
  status           String    @default("active") @db.VarChar(24)
  expiresAt        DateTime
  committedAt      DateTime?
  releasedAt       DateTime?
  createdAt        DateTime  @default(now())

  paymentAttempt PaymentAttempt  @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([paymentAttemptId, variantReference])
  @@index([variantId, status, expiresAt])
}

model PaymentProviderEvent {
  id               String   @id @default(cuid())
  paymentAttemptId String
  provider         String   @db.VarChar(24)
  externalId       String   @db.VarChar(191)
  kind             String   @db.VarChar(32)
  payloadDigest    String   @db.Char(64)
  createdAt        DateTime @default(now())

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([paymentAttemptId, createdAt])
}

model Order {
  id                    String   @id @default(cuid())
  number                String   @unique @db.VarChar(64)
  flavor                String   @db.VarChar(16)
  shopperId             String
  paymentAttemptId      String   @unique
  paymentStatus         String   @default("paid") @db.VarChar(24)
  fulfillmentStatus     String   @default("unfulfilled") @db.VarChar(24)
  returnStatus          String   @default("none") @db.VarChar(24)
  provider              String   @db.VarChar(24)
  providerTradeNo       String   @db.VarChar(128)
  currency              String   @db.Char(3)
  subtotalMinor         Int
  discountCode          String?  @db.VarChar(64)
  discountMinor         Int
  shippingRateReference String?  @db.VarChar(191)
  shippingNameZh        String?  @db.VarChar(160)
  shippingNameEn        String?  @db.VarChar(160)
  shippingMinor         Int
  totalMinor            Int
  totalWeightGrams      Int
  recipientName         String   @db.VarChar(120)
  phone                 String   @db.VarChar(40)
  countryCode           String   @db.Char(2)
  region                String   @db.VarChar(120)
  city                  String   @db.VarChar(120)
  district              String?  @db.VarChar(120)
  postalCode            String?  @db.VarChar(32)
  line1                 String   @db.VarChar(240)
  line2                 String?  @db.VarChar(240)
  trackingNumber        String?  @db.VarChar(191)
  paidAt                DateTime
  shippedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shopper        Shopper        @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  lines          OrderLine[]

  @@index([flavor, createdAt])
  @@index([shopperId, createdAt])
  @@index([fulfillmentStatus, createdAt])
}

model OrderLine {
  id                String  @id @default(cuid())
  orderId           String
  variantReference  String  @db.VarChar(191)
  productReference  String  @db.VarChar(191)
  productSlug       String  @db.VarChar(180)
  productNameZh     String? @db.VarChar(160)
  productNameEn     String? @db.VarChar(160)
  variantLabel      String  @db.VarChar(512)
  imageUrl          String? @db.VarChar(512)
  unitPriceMinor    Int
  quantity          Int
  lineSubtotalMinor Int
  unitWeightGrams   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CartLine {
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@index([variantId])
}

model MailConfig {
  flavor       String  @id @db.VarChar(16)
  host         String  @db.VarChar(255)
  port         Int
  secure       Boolean @default(true)
  username     String? @db.VarChar(255)
  password     String? @db.VarChar(512)
  fromEmail    String  @db.VarChar(320)
  ownerToEmail String  @db.VarChar(320)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

}

model MailOutbox {
  id         String    @id @default(cuid())
  flavor     String    @db.VarChar(16)
  eventKey   String    @db.VarChar(191)
  kind       String    @db.VarChar(32)
  toEmail    String    @db.VarChar(320)
  subject    String    @db.VarChar(255)
  bodyText   String
  status     String    @default("pending") @db.VarChar(24)
  attempts   Int       @default(0)
  lastError  String?   @db.VarChar(500)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([flavor, eventKey])
  @@index([flavor, status, createdAt])
}

model ShopperPasswordReset {
  id         String    @id @default(cuid())
  shopperId  String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([shopperId, createdAt])
}
