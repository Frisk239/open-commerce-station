generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Station {
  flavor         String   @id @db.VarChar(16)
  name           String   @db.VarChar(120)
  logoUrl        String?  @db.VarChar(512)
  faviconUrl     String?  @db.VarChar(512)
  contactEmail   String?  @db.VarChar(320)
  footerLine     String?  @db.VarChar(240)
  icp            String?  @db.VarChar(120)
  policeRecord   String?  @db.VarChar(120)
  policeBadgeUrl String?  @db.VarChar(512)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Owner {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CatalogGroup {
  id        String   @id @default(cuid())
  flavor    String   @db.VarChar(16)
  slug      String   @db.VarChar(180)
  nameZh    String?  @db.VarChar(160)
  nameEn    String?  @db.VarChar(160)
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   CatalogGroup?            @relation("CatalogGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CatalogGroup[]           @relation("CatalogGroupTree")
  products ProductGroupAssignment[]

  @@unique([flavor, slug])
  @@index([flavor, parentId, position])
}

model Product {
  id        String    @id @default(cuid())
  flavor    String    @db.VarChar(16)
  slug      String    @db.VarChar(180)
  nameZh    String?   @db.VarChar(160)
  nameEn    String?   @db.VarChar(160)
  storyZh   String?
  storyEn   String?
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images   ProductImage[]
  groups   ProductGroupAssignment[]
  options  ProductOption[]
  variants ProductVariant[]

  @@unique([flavor, slug])
  @@index([flavor, published, deletedAt, createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String @db.VarChar(512)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, position])
}

model ProductGroupAssignment {
  productId String
  groupId   String

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   CatalogGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model ProductOption {
  id        String  @id
  productId String
  key       String  @db.VarChar(80)
  nameZh    String? @db.VarChar(160)
  nameEn    String? @db.VarChar(160)
  position  Int     @default(0)

  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     ProductOptionValue[]
  selections VariantSelection[]

  @@unique([productId, key])
  @@index([productId, position])
}

model ProductOptionValue {
  id       String  @id
  optionId String
  key      String  @db.VarChar(80)
  nameZh   String? @db.VarChar(160)
  nameEn   String? @db.VarChar(160)
  position Int     @default(0)

  option     ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantSelection[]

  @@unique([optionId, key])
  @@index([optionId, position])
}

model ProductVariant {
  id                 String @id
  productId          String
  combinationKey     String @db.VarChar(512)
  sellPriceMinor     Int
  originalPriceMinor Int?
  stock              Int
  weightGrams        Int

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  selections VariantSelection[]
  cartLines  CartLine[]

  @@unique([productId, combinationKey])
  @@index([productId])
}

model VariantSelection {
  variantId String
  optionId  String
  valueId   String

  variant ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option  ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([valueId])
}

model Cart {
  id        String   @id @default(cuid())
  flavor    String   @db.VarChar(16)
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines CartLine[]

  @@index([flavor, updatedAt])
}

model CartLine {
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@index([variantId])
}
